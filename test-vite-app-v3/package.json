{
  "name": "test-vite-app-v3",
  "version": "0.0.1",
  "private": true,
  "description": "A Quasar Project",
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-app-vite",
    "quasar-cli",
    "vite",
    "vue",
    "vuejs"
  ],
  "author": "Yusuf Kandemir <yusuf.kandemir@outlook.com.tr>",
  "type": "module",
  "scripts": {
    "lint": "oxfmt && oxlint --fix",
    "lint:check": "oxfmt --check && oxlint",
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent",
    "sync:vitest": "pnpm --filter @quasar/quasar-app-extension-testing-unit-vitest build && quasar clean --cache && pnpm postinstall",
    "invoke:vitest": "quasar ext invoke @quasar/testing-unit-vitest && pnpm lint",
    "sync:invoke:vitest": "pnpm sync:vitest && pnpm invoke:vitest",
    "test:vitest": "pnpm test:unit:ci",
    "sync:cypress": "pnpm --filter @quasar/quasar-app-extension-testing-e2e-cypress build && quasar clean --cache && pnpm postinstall",
    "invoke:cypress": "quasar ext invoke @quasar/testing-e2e-cypress && pnpm lint",
    "sync:invoke:cypress": "pnpm sync:cypress && pnpm invoke:cypress",
    "test:cypress": "cross-env NODE_ENV=test start-test \"quasar dev\" http-get://localhost:8080 \"cypress run --e2e\" && cross-env NODE_ENV=test cypress run --component",
    "sync:playwright": "pnpm --filter @quasar/quasar-app-extension-testing-playwright build && quasar clean --cache && pnpm postinstall",
    "invoke:playwright": "quasar ext invoke @quasar/testing-playwright && pnpm lint",
    "sync:invoke:playwright": "pnpm sync:playwright && pnpm invoke:playwright",
    "test:playwright": "playwright test",
    "sync:all": "pnpm sync:vitest && pnpm sync:cypress && pnpm sync:playwright",
    "test:all": "pnpm test:vitest && pnpm test:cypress && pnpm test:playwright",
    "test": "echo \"See package.json => scripts for available tests.\" && exit 0",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run",
    "test:unit:ui": "vitest --ui",
    "test:e2e": "playwright test --project=e2e --ui",
    "test:e2e:ci": "playwright test --project=e2e",
    "test:component": "playwright test --project=components --ui",
    "test:component:ci": "playwright test --project=components",
    "test:coverage:report": "nyc report",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.4",
    "quasar": "^2.32.0",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^4.0.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@playwright/test": "^1.63.0",
    "@quasar/app-vite": "^3.8.0",
    "@quasar/quasar-app-extension-testing-e2e-cypress": "workspace:*",
    "@quasar/quasar-app-extension-testing-playwright": "workspace:*",
    "@quasar/quasar-app-extension-testing-unit-vitest": "workspace:*",
    "@types/node": "^22.19.11",
    "@vitest/ui": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.27",
    "cross-env": "^10.1.0",
    "cypress": "^15.21.0",
    "eslint-plugin-playwright": "^2.11.0",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.23.0",
    "nyc": "^18.0.0",
    "oxfmt": "^0.x",
    "oxlint": "^1.x",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.8",
    "start-server-and-test": "^3.0.12",
    "typescript": "^6.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.3"
  },
  "dependenciesMeta": {
    "@quasar/quasar-app-extension-testing-e2e-cypress": {
      "injected": true
    },
    "@quasar/quasar-app-extension-testing-playwright": {
      "injected": true
    },
    "@quasar/quasar-app-extension-testing-unit-vitest": {
      "injected": true
    }
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  },
  "productName": "Quasar App"
}
