{
  "name": "test-vite-app-v3",
  "version": "0.0.1",
  "private": true,
  "description": "A Quasar Project",
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-app-vite",
    "quasar-cli",
    "vite",
    "vue",
    "vuejs"
  ],
  "author": "Yusuf Kandemir <yusuf.kandemir@outlook.com.tr>",
  "type": "module",
  "scripts": {
    "lint": "oxfmt && oxlint --fix",
    "lint:check": "oxfmt --check && oxlint",
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent",
    "sync:vitest": "pnpm --dir ../packages/unit-vitest build && pnpm add -D file:../packages/unit-vitest --ignore-scripts && pnpm --dir .. install && pnpm postinstall",
    "invoke:vitest": "quasar ext invoke @quasar/testing-unit-vitest && pnpm lint",
    "sync:invoke:vitest": "pnpm sync:vitest && pnpm invoke:vitest",
    "test:vitest": "pnpm test:unit:ci",
    "sync:cypress": "pnpm --dir ../packages/e2e-cypress build:local && pnpm add -D file:../packages/e2e-cypress --ignore-scripts && pnpm --dir .. install && pnpm postinstall",
    "invoke:cypress": "quasar ext invoke @quasar/testing-e2e-cypress && pnpm lint",
    "sync:invoke:cypress": "pnpm sync:cypress && pnpm invoke:cypress",
    "test:cypress": "pnpm test:e2e:ci && pnpm test:component:ci",
    "sync:all": "pnpm sync:vitest && pnpm sync:cypress",
    "test:all": "pnpm test:vitest && pnpm test:cypress",
    "test": "echo \"See package.json => scripts for available tests.\" && exit 0",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run",
    "test:unit:ui": "vitest --ui",
    "test:e2e": "cross-env NODE_ENV=test start-test \"quasar dev\" http-get://localhost:8080 \"cypress open --e2e\"",
    "test:e2e:ci": "cross-env NODE_ENV=test start-test \"quasar dev\" http-get://localhost:8080 \"cypress run --e2e\"",
    "test:component": "cross-env NODE_ENV=test cypress open --component",
    "test:component:ci": "cross-env NODE_ENV=test cypress run --component"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.4",
    "quasar": "^2.25.1",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^4.0.3",
    "@quasar/app-vite": "^3.7.0",
    "@quasar/quasar-app-extension-testing-e2e-cypress": "file:../packages/e2e-cypress",
    "@quasar/quasar-app-extension-testing-unit-vitest": "file:../packages/unit-vitest",
    "@types/node": "^22.19.11",
    "@vitest/ui": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.27",
    "cross-env": "^10.1.0",
    "cypress": "^15.21.0",
    "oxfmt": "^0.x",
    "oxlint": "^1.x",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.8",
    "start-server-and-test": "^3.0.12",
    "typescript": "^6.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  },
  "productName": "Quasar App"
}
