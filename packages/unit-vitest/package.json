{
  "name": "@quasar/quasar-app-extension-testing-unit-vitest",
  "version": "3.0.0",
  "type": "module",
  "license": "MIT",
  "description": "A Quasar App Extension for running tests with Vitest",
  "contributors": [
    "Paolo Caleffi",
    "Evert van der Weit",
    "Yusuf Kandemir"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/quasarframework/quasar-testing"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "obuild",
    "clean": "rimraf node_modules",
    "deploy:alpha": "pnpm build && pnpm publish --tag alpha",
    "deploy:beta": "pnpm build && pnpm publish --tag beta",
    "deploy:latest": "pnpm build && pnpm publish --tag latest"
  },
  "filesComments": {
    "tsconfig.json": [
      "app-vite v3 loads AE scripts with jiti tsconfig-paths support, which uses the nearest tsconfig.",
      "Shipping our tsconfig stops the app's tsconfig from mapping '#q-app' to a .d.ts file, which breaks things."
    ]
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "imports": {
    "#q-app": "@quasar/app-vite"
  },
  "exports": {
    ".": "./src/helpers/main.ts",
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^30 || ^28 || ^26 || ^24 || ^22.12.0",
    "npm": ">= 10"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "es-toolkit": "^1.51.0",
    "happy-dom": "^20.11.6"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.7.0",
    "@vitest/ui": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "obuild": "^0.4.38",
    "quasar": "^2.25.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "vue": "^3.5.41"
  },
  "peerDependencies": {
    "@quasar/app-vite": "^3.0.0",
    "@vitest/ui": "^4.0.0 || ^5.0.0",
    "@vue/test-utils": "^2.4.6",
    "quasar": "^2.24.0",
    "vitest": "^4.0.0 || ^5.0.0",
    "vue": "^3.3.4"
  },
  "peerDependenciesMeta": {
    "@vitest/ui": {
      "optional": true
    }
  }
}
