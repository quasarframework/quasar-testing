{
  "name": "@quasar/quasar-app-extension-testing-e2e-cypress",
  "version": "7.0.0",
  "license": "MIT",
  "description": "A Quasar App Extension for Cypress e2e",
  "contributors": [
    "Paolo Caleffi",
    "Daniel Thompson-Yvetot"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/quasarframework/quasar-testing"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "obuild",
    "deploy:alpha": "pnpm build && pnpm publish --tag alpha",
    "deploy:beta": "pnpm build && pnpm publish --tag beta",
    "deploy:latest": "pnpm build && pnpm publish --tag latest"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "imports": {
    "#q-app": "@quasar/app-vite"
  },
  "exports": {
    ".": {
      "types": "./src/helpers/main.ts",
      "import": "./dist/helpers/main.mjs"
    },
    "./cct-dev-server": {
      "types": "./src/helpers/cct-dev-server/index.ts",
      "import": "./dist/helpers/cct-dev-server/index.mjs"
    },
    "./nyc-config-preset": "./nyc-config-preset.json",
    "./nyc-config-preset.json": "./nyc-config-preset.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^30 || ^28 || ^26 || ^24 || ^22.22.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "es-toolkit": "^1.42.0",
    "vite-plugin-istanbul": "^9.0.1"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^4.0.3",
    "@quasar/app-vite": "^3.8.0",
    "cross-env": "^10.1.0",
    "cypress": "^15.21.0",
    "eslint-plugin-cypress": "^7.0.1",
    "obuild": "^0.4.38",
    "quasar": "^2.25.1",
    "start-server-and-test": "^3.0.12",
    "vue": "^3.5.41",
    "vue-router": "^5.0.6"
  },
  "peerDependencies": {
    "@quasar/app-vite": "^3.0.0",
    "cypress": "^15.14.0",
    "quasar": "^2.24.0",
    "vue": "^3.3.4"
  },
  "filesComments": {
    "tsconfig.json": [
      "app-vite v3 loads AE scripts with jiti tsconfig-paths support, which uses the nearest tsconfig.",
      "Shipping ours stops the app's tsconfig from mapping '#q-app' to a .d.ts file."
    ]
  },
  "files": [
    "dist",
    "nyc-config-preset.json",
    "src",
    "tsconfig.json"
  ]
}
